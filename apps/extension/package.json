{
  "name": "@live2d-chat/extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt --mv3",
    "build": "pnpm build:chrome && pnpm build:edge",
    "build:chrome": "wxt build --browser chrome --mv3",
    "build:edge": "wxt build --browser edge --mv3",
    "zip": "pnpm zip:chrome && pnpm zip:edge",
    "zip:chrome": "wxt zip --browser chrome --mv3",
    "zip:edge": "wxt zip --browser edge --mv3",
    "clean": "wxt clean",
    "test": "vitest run --root ../.. apps/extension",
    "typecheck": "wxt prepare && tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@live2d-chat/shared": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wxt": "^0.21.4"
  }
}
